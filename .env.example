# Public site URL (overrides SITE_URL in lib/site.ts if set). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.calcsolver.com

# Google Analytics 4 measurement ID. Loaded ONLY after the visitor accepts analytics cookies.
NEXT_PUBLIC_GA_ID=

# Contact form delivery (see app/api/contact/route.ts).
# When RESEND_API_KEY and CONTACT_TO_EMAIL are both set, messages are emailed via Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be a sender on a domain you verified in Resend.
CONTACT_FROM_EMAIL=CalcSolver <noreply@calcsolver.com>
